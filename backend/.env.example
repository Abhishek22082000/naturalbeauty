# Copy this file to .env and fill in real values.
# Never commit .env — it holds secrets.

# JWT signing secret — use a long random string
JWT_SECRET=

# MySQL connection
# WAMP sometimes runs MySQL on 3307 when 3306 is taken — check with
# netstat, or WAMP tray icon > MySQL > Service, if you get ECONNREFUSED.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=

# Server
PORT=3000
